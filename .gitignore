node_modules
.DS_Store
.vscode

# audit run output (regenerable)
# Anchored: a bare "output/" also matches src/output/ and silently drops
# source files from the repo.
/output/
/output-*/
/out/
*.zip

# planning artifacts: track docs, never data dumps
plans/**/*.json
plans/**/*.jsonl
plans/**/*.csv

# credentials — never commit
*service-account*.json
*credentials*.json

# local-only project instructions (never been tracked)
CLAUDE.md

# browser automation artifacts
.playwright-mcp/

# Build output. Only the npm tarball carries it; the repo runs from src.
/dist/

# npm pack output and browser-check debris.
*.tgz
