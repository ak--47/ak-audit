{
	"name": "ak-audit",
	"version": "2.0.0",
	"type": "module",
	"description": "Map a BigQuery dataset for agents and humans: metadata, column stats, relationships, usage, and a searchable report",
	"keywords": [
		"bigquery",
		"data-catalog",
		"data-discovery",
		"schema",
		"profiling",
		"cli"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ak--47/ak-audit.git"
	},
	"bugs": {
		"url": "https://github.com/ak--47/ak-audit/issues"
	},
	"homepage": "https://github.com/ak--47/ak-audit#readme",
	"bin": {
		"ak-audit": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"audit": "tsx src/cli.ts audit",
		"extract": "tsx src/cli.ts extract",
		"profile": "tsx src/cli.ts profile",
		"analyze": "tsx src/cli.ts analyze",
		"report": "tsx src/cli.ts report",
		"serve": "npx --yes serve ./output/report",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"prepack": "npm run build",
		"prepublishOnly": "npm run typecheck && npm test"
	},
	"dependencies": {
		"@google-cloud/bigquery": "^9.0.3",
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.15.3",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
