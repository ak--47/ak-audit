{
	"name": "ak-audit",
	"private": true,
	"type": "module",
	"description": "CLI that maps a BigQuery dataset for agents and humans",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"audit": "tsx src/cli.ts audit",
		"extract": "tsx src/cli.ts extract",
		"profile": "tsx src/cli.ts profile",
		"analyze": "tsx src/cli.ts analyze",
		"report": "tsx src/cli.ts report",
		"serve": "npx --yes serve ./output/report",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@google-cloud/bigquery": "^9.0.3",
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.15.3",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
